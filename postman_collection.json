              "if (response.orderId) {",
              "    pm.collectionVariables.set('orderId', response.orderId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Distributor-Id",
            "value": "dist-gold-01"
          },
          {
            "key": "Idempotency-Key",
            "value": "order-gold-key-101"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product\": \"oyster\",\n  \"grade\": \"A\",\n  \"grams\": 12500,\n  \"deliveryDate\": \"2026-11-22\",\n  \"allowPartial\": false\n}"
